# PostgreSQL connection for the helpdesk database.
# Replace the password placeholder with your local postgres password, then run:
#   bunx prisma migrate dev --name init
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGIN=http://localhost:5173

# Seed admin user
ADMIN_EMAIL=admin@example.com
AGENT_EMAIL=agent@example.com
# Required. Minimum 12 characters — the seed script refuses weak passwords.
ADMIN_PASSWORD=password123

# Inbound email (see server/EMAIL.md for provider setup)
# Shared secret for SendGrid Inbound Parse (and for testing with curl).
# Send it as the x-webhook-secret header or a ?secret= query parameter.
WEBHOOK_SECRET=

# Mailgun webhook signing key. When set, Mailgun requests are authenticated
# with their HMAC-SHA256 signature instead of WEBHOOK_SECRET.
MAILGUN_SIGNING_KEY=